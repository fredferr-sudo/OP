# ---------------------------------------------------------------------------
# Serveur
# ---------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
DATABASE_PATH=./data/op.db

# Heure du relevé quotidien de prix (cron, fuseau du serveur).
# Par défaut : tous les jours à 04:15.
PRICE_CRON=15 4 * * *
# Synchronisation du catalogue : une fois par semaine suffit largement.
CATALOG_CRON=0 3 * * 1
# Passe à false pour désactiver toute tâche planifiée (utile en dev).
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Catalogue des cartes
# ---------------------------------------------------------------------------
# Fournisseur : dotgg | apitcg | local
#   dotgg  — tout le catalogue en un appel, sans clé, avec les identifiants
#            produit Cardmarket et TCGplayer et leurs prix courants (défaut)
#   apitcg — apitcg.com, nécessite une clé gratuite ; dotgg reste en secours
#   local  — jeu de données de démonstration embarqué, pour travailler hors ligne
CATALOG_PROVIDER=dotgg
APITCG_KEY=
# Adresse de la source dotgg, modifiable si elle change.
DOTGG_URL=https://api.dotgg.gg/cgfw/getcards?game=onepiece

# ---------------------------------------------------------------------------
# Cardmarket — API officielle (OAuth 1.0a, "App Token" dédié)
# https://api.cardmarket.com/ws/documentation
# ---------------------------------------------------------------------------
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=
CARDMARKET_ACCESS_TOKEN=
CARDMARKET_ACCESS_SECRET=
# Bac à sable de Cardmarket pendant le développement.
CARDMARKET_BASE_URL=https://api.cardmarket.com/ws/v2.0/output.json

# ---------------------------------------------------------------------------
# TCGplayer — API officielle (OAuth2 client credentials)
# https://docs.tcgplayer.com
# ---------------------------------------------------------------------------
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# eBay — Browse API (OAuth2 client credentials)
# https://developer.ebay.com/api-docs/buy/browse/overview.html
# ---------------------------------------------------------------------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_FR
# Sandbox : https://api.sandbox.ebay.com
EBAY_BASE_URL=https://api.ebay.com
